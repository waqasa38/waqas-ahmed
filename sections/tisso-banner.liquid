      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Choose gift"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Header background",
      "default": "#F7F6F4"
    },
    {
      "type": "color",
      "id": "panel_bg_color",
      "label": "Mobile panel background",
      "default": "#EDECEA"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#141414"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#F5E900"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#141414"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Button hover background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button hover text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Banner"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner image"
    },
    {
      "type": "text",
      "id": "banner_heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "banner_description",
      "label": "Description (desktop)",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    {
      "type": "richtext",
      "id": "banner_description_mobile",
      "label": "Description (mobile)",
      "info": "If left blank, the desktop description is used instead.",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination.</p>"
    },
    {
      "type": "text",
      "id": "banner_button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "banner_button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "banner_footer_text",
      "label": "Footer strip text",
      "default": "Sustainable, ethically made clothes in sizes XXS to 6XL"
    },
      {
      "type": "text",
      "id": "banner_footer_mobile",
      "label": "Footer strip (mobile)",
      "info": "If left blank, the desktop description is used instead.",
       "default": "SUSTAINABLE, ETHICALLY MADE ACTIVEWEAR"
    },
    {
      "type": "header",
      "content": "Banner colors"
    },
    {
      "type": "color",
      "id": "banner_heading_color",
      "label": "Heading color",
      "default": "#141414"
    },
    {
      "type": "color",
      "id": "banner_text_color",
      "label": "Description color",
      "default": "#141414"
    },
    {
      "type": "color",
      "id": "banner_button_bg_color",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "banner_button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "banner_button_hover_bg_color",
      "label": "Button hover background",
      "default": "#F5E900"
    },
    {
      "type": "color",
      "id": "banner_button_hover_text_color",
      "label": "Button hover text",
      "default": "#141414"
    },
    {
      "type": "color",
      "id": "banner_footer_bg_color",
      "label": "Footer strip background",
      "default": "#F7F6F4"
    },
    {
      "type": "color",
      "id": "banner_footer_text_color",
      "label": "Footer strip text color",
