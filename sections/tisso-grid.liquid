    }

    #tisso-vision-{{ section.id }} .tisso-size__list {
      position: absolute;
      z-index: 10;
      top: calc(100% - 1px);
      left: 0;
      right: 0;
      max-height: 145px;
      overflow-x: hidden;
      overflow-y: auto;
      border: 1px solid #111;
      border-top: 0;
      box-sizing: border-box;
      box-shadow: 0 8px 18px rgba(0, 0, 0, .12);
    }

    #tisso-vision-{{ section.id }} .tisso-size__option {
      min-height: 44px;
      padding: 0 16px;
      display: flex;
      align-items: center;
      box-sizing: border-box;
      font-size: 18px;
      line-height: 1;
    }

    #tisso-vision-{{ section.id }} .tisso-add {
      height: 53px;
      min-height: 53px;
      margin-top: 28px;
      box-sizing: border-box;
      font-size: 17px;
      justify-content: center;
      gap: 30px;
      padding: 15px 0 15px 20px;
      font-size: 16px;
      letter-spacing: 0;
      font-weight: 400;
      font-family: 'Jost';
    }

    #tisso-vision-{{ section.id }} .tisso-add__arrow {
      font-size: 28px;
      line-height: 1;
      font-weight: 300;
    }

    #tisso-vision-{{ section.id }} .tisso-modal__error {
      margin-top: 8px;
      font-size: 11px;
    }

    /*
     * Size dropdown — ONLY the requested visual changes:
     * 1. Separate right-side chevron box with vertical divider.
     * 2. White dropdown option background.
     *
     * Existing height, typography, hover and selected-state styling remain
     * unchanged from the previous version.
     */
    #tisso-vision-{{ section.id }} .tisso-size__trigger {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 48px;
      align-items: stretch;
      gap: 0;
      padding: 0;
      box-sizing: border-box;
    }

    #tisso-vision-{{ section.id }} .tisso-size__value {
      display: flex;
      align-items: center;
      min-width: 0;
      padding-left: 12px;
      box-sizing: border-box;
    }

    #tisso-vision-{{ section.id }} .tisso-size__chevron {
      width: auto;
      height: auto;
      margin: 0;
      border: 0;
      border-left: 1px solid #111;
      border-radius: 0;
      transform: none;
      position: relative;
      box-sizing: border-box;
    }

    #tisso-vision-{{ section.id }} .tisso-size__chevron::after {
      content: "";
      position: absolute;
      width: 8px;
      height: 8px;
      left: 50%;
      top: 50%;
      border-right: 1.5px solid #111;
      border-bottom: 1.5px solid #111;
      transform: translate(-50%, -65%) rotate(45deg);
      box-sizing: border-box;
    }

    #tisso-vision-{{ section.id }} .tisso-size[data-open="true"] .tisso-size__chevron {
      transform: none;
    }

    #tisso-vision-{{ section.id }} .tisso-size[data-open="true"] .tisso-size__chevron::after {
      transform: translate(-50%, -35%) rotate(-135deg);
    }

    #tisso-vision-{{ section.id }} .tisso-size__list {
      background: #fff;
    }

    #tisso-vision-{{ section.id }} .tisso-size__option {
      background: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    @media (prefers-reduced-motion: reduce) {
      #tisso-vision-{{ section.id }} .tisso-modal__dialog,
      #tisso-vision-{{ section.id }} .tisso-modal__backdrop {
        transition: none;
      }
    }
  </style>

  <script>
    (() => {
      const root = document.getElementById('tisso-vision-{{ section.id }}');
      if (!root) return;

      const sectionId = '{{ section.id }}';
      const shopRoot = window.Shopify && window.Shopify.routes && window.Shopify.routes.root
        ? window.Shopify.routes.root
        : '/';

      const products = JSON.parse(
        root.querySelector('[data-tisso-products]').textContent || '[]'
      );

      const companion = JSON.parse(
        root.querySelector('[data-tisso-companion]').textContent || 'null'
      );

      const modal = root.querySelector('[data-tisso-modal]');
      const dialog = modal.querySelector('.tisso-modal__dialog');
      const modalImage = root.querySelector('[data-tisso-modal-image]');
      const modalTitle = root.querySelector('[data-tisso-modal-title]');
      const modalPrice = root.querySelector('[data-tisso-modal-price]');
      const modalDescription = root.querySelector('[data-tisso-modal-description]');
      const variantsContainer = root.querySelector('[data-tisso-variants]');
      const form = root.querySelector('[data-tisso-product-form]');
      const errorEl = root.querySelector('[data-tisso-error]');
      const addButton = root.querySelector('[data-tisso-add]');
      const addLabel = root.querySelector('[data-tisso-add-label]');

      const POPUP_MARGIN = 16;
      const BODY_OPEN_CLASS = 'tisso-modal-open-{{ section.id }}';

      let activeProduct = null;
      let activeTrigger = null;
      let previousActiveElement = null;
      let closeTimer = null;

      // Approximate named colours so the segmented buttons show a real
      // colour swatch instead of always defaulting to plain white.
      const COLOR_KEYWORDS = {
        black: '#000000',
        white: '#ffffff',
        blue: '#33578f',
        navy: '#1e2a4a',
        red: '#8f1d34',
        grey: '#b5b5b5',
        gray: '#b5b5b5',
        green: '#2f6b3a',
        olive: '#6b6b3a',
        beige: '#e3d5b8',
        cream: '#f2ead9',
        tan: '#cdb08a',
        brown: '#6b4a30',
        pink: '#e59bb0',
        yellow: '#e3c23c',
        orange: '#dd7a2c',
        purple: '#6b4b9a',
        khaki: '#b3a97e',
        denim: '#3f5872',
        multi: 'conic-gradient(#8f1d34,#e3c23c,#2f6b3a,#33578f,#6b4b9a,#8f1d34)'
      };

      const resolveSwatchColor = (value) => {
        const key = String(value || '').trim().toLowerCase();
        if (COLOR_KEYWORDS[key]) return COLOR_KEYWORDS[key];
        return key || '#e5e5e5';
      };

      const setImage = (url, alt) => {
        if (!url) {
          modalImage.removeAttribute('src');
          modalImage.alt = '';
          modalImage.hidden = true;
          return;
        }

        modalImage.src = url;
        modalImage.alt = alt || '';
        modalImage.hidden = false;
      };

      const clearError = () => {
        errorEl.hidden = true;
        errorEl.textContent = '';
      };

      const showError = (message) => {
        errorEl.textContent = message;
        errorEl.hidden = false;
      };

      const isSimpleProduct = (product) => {
        return (
          product?.variants?.length === 1 &&
          product.options?.length === 1 &&
          String(product.options[0].name).trim().toLowerCase() === 'title'
        );
      };

      const getSelectedOptions = () => {
        if (!activeProduct || !activeProduct.options) return [];

        if (isSimpleProduct(activeProduct)) {
          return activeProduct.variants[0].options.slice(0, activeProduct.options.length);
        }

        return activeProduct.options.map((option, index) => {
          const select = form.querySelector(
            `select[name="option-${index}"]`
          );

          if (select) {
            return select.value || null;
          }

          const checked = form.querySelector(
            `input[name="option-${index}"]:checked`
          );

          return checked ? checked.value : null;
        });
      };

      const findVariant = () => {
        if (!activeProduct) return null;
        if (isSimpleProduct(activeProduct)) return activeProduct.variants[0] || null;

        const selectedOptions = getSelectedOptions();

        return activeProduct.variants.find((variant) => {
          return variant.options.every((value, index) => {
            return value === selectedOptions[index];
          });
        }) || null;
      };

      const getPossibleVariant = (optionIndex, optionValue) => {
        if (!activeProduct) return null;
        if (isSimpleProduct(activeProduct)) return activeProduct.variants[0] || null;

        const selectedOptions = getSelectedOptions();
        selectedOptions[optionIndex] = optionValue;

        return activeProduct.variants.find((variant) => {
          return variant.options.every((value, index) => {
            if (index === optionIndex) return value === optionValue;
            if (!selectedOptions[index]) return true;
            return value === selectedOptions[index];
          });
        }) || null;
      };

      const updateVariantAvailability = () => {
        if (!activeProduct) return;

        activeProduct.options.forEach((option, optionIndex) => {
          const control = form.querySelector(`[name="option-${optionIndex}"]`);

          if (!control) return;

          if (control.tagName === 'SELECT') {
            Array.from(control.options).forEach((optionEl) => {
              if (!optionEl.value) return;

              const possible = getPossibleVariant(optionIndex, optionEl.value);
              optionEl.disabled = !possible || !possible.available;
            });
          } else {
            form.querySelectorAll(
              `input[name="option-${optionIndex}"]`
            ).forEach((input) => {
              const possible = getPossibleVariant(optionIndex, input.value);
              input.disabled = !possible || !possible.available;

              if (input.disabled && input.checked) {
                const selectedOptions = getSelectedOptions();
                selectedOptions[optionIndex] = input.value;

                const exactVariant = activeProduct.variants.find((variant) =>
                  variant.options.every((value, index) => {
                    return !selectedOptions[index] ||
                      value === selectedOptions[index];
                  })
                );

                if (!exactVariant) input.checked = false;
              }
            });
          }
        });

        const variant = findVariant();

        if (variant) {
          if (variant.featuredImage) {
            setImage(variant.featuredImage, activeProduct.title);
          }

          modalPrice.textContent = variant.priceFormatted;
          addButton.disabled = !variant.available;
          addLabel.textContent = variant.available ? 'ADD TO CART' : 'SOLD OUT';
        } else {
          modalPrice.textContent = activeProduct.priceFormatted || '';
          addButton.disabled = true;
          addLabel.textContent = 'SELECT OPTIONS';
        }

        syncSizeControls();
      };

      const renderColorOption = (option, optionIndex) => {
        const wrapper = document.createElement('div');
        wrapper.className = 'tisso-variant';

        const label = document.createElement('span');
        label.className = 'tisso-variant__label';
        label.textContent = option.name;
        wrapper.appendChild(label);

        const values = document.createElement('div');
        values.className = 'tisso-variant__values';

        option.values.forEach((value, valueIndex) => {
          const valueWrapper = document.createElement('div');
          valueWrapper.className = 'tisso-variant__value';

          const id = `tisso-${sectionId}-option-${optionIndex}-${valueIndex}`;

          const input = document.createElement('input');
          input.type = 'radio';
          input.className = 'tisso-variant__input';
          input.id = id;
          input.name = `option-${optionIndex}`;
          input.value = value;

          const button = document.createElement('label');
          button.className = 'tisso-variant__button';
          button.setAttribute('for', id);

          const swatch = document.createElement('span');
          swatch.className = 'tisso-variant__swatch';
          swatch.setAttribute('aria-hidden', 'true');
          swatch.style.background = resolveSwatchColor(value);

          const text = document.createElement('span');
          text.className = 'tisso-variant__button-text';
          text.textContent = value;

          button.appendChild(swatch);
          button.appendChild(text);

          input.addEventListener('change', updateVariantAvailability);

          valueWrapper.appendChild(input);
          valueWrapper.appendChild(button);
          values.appendChild(valueWrapper);
        });

        wrapper.appendChild(values);
        return wrapper;
      };

      // Closes every open custom size dropdown except an optional one to skip.
      const closeAllSizeLists = (exceptEl) => {
        form.querySelectorAll('[data-tisso-size]').forEach((sizeEl) => {
          if (sizeEl === exceptEl) return;

          sizeEl.dataset.open = 'false';
          const trigger = sizeEl.querySelector('.tisso-size__trigger');
          const list = sizeEl.querySelector('.tisso-size__list');
          if (trigger) trigger.setAttribute('aria-expanded', 'false');
          if (list) list.hidden = true;
        });
      };

      const isAnySizeListOpen = () => {
        return !!form.querySelector('[data-tisso-size][data-open="true"]');
      };

      const renderDropdownOption = (option, optionIndex) => {
        const wrapper = document.createElement('div');
        wrapper.className = 'tisso-variant';

        const placeholderText = `Choose your ${option.name.toLowerCase()}`;

        const label = document.createElement('label');
        label.className = 'tisso-variant__label';
        label.setAttribute('for', `tisso-${sectionId}-select-${optionIndex}`);
        label.textContent = option.name;
        wrapper.appendChild(label);

        // Hidden native select stays the source of truth for value/availability logic.
        const select = document.createElement('select');
        select.className = 'tisso-variant__select-native';
        select.id = `tisso-${sectionId}-select-${optionIndex}`;
        select.name = `option-${optionIndex}`;
        select.tabIndex = -1;
        select.setAttribute('aria-hidden', 'true');

        const placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = placeholderText;
        select.appendChild(placeholder);

        option.values.forEach((value) => {
          const optionEl = document.createElement('option');
          optionEl.value = value;
          optionEl.textContent = value;
          select.appendChild(optionEl);
        });

        // Visible custom control (Component 213 closed/open states).
        const sizeEl = document.createElement('div');
        sizeEl.className = 'tisso-size';
        sizeEl.dataset.tissoSize = '';
        sizeEl.dataset.open = 'false';

        const trigger = document.createElement('button');
        trigger.type = 'button';
        trigger.className = 'tisso-size__trigger';
        trigger.setAttribute('aria-haspopup', 'listbox');
        trigger.setAttribute('aria-expanded', 'false');

        const valueSpan = document.createElement('span');
        valueSpan.className = 'tisso-size__value';
        valueSpan.textContent = placeholderText;

        const chevron = document.createElement('span');
        chevron.className = 'tisso-size__chevron';
        chevron.setAttribute('aria-hidden', 'true');

        trigger.appendChild(valueSpan);
        trigger.appendChild(chevron);

        const list = document.createElement('ul');
        list.className = 'tisso-size__list';
        list.setAttribute('role', 'listbox');
        list.hidden = true;

        option.values.forEach((value) => {
          const item = document.createElement('li');
          item.className = 'tisso-size__option';
          item.setAttribute('role', 'option');
          item.setAttribute('tabindex', '0');
          item.dataset.value = value;
          item.textContent = value;

          const chooseSize = () => {
            if (item.getAttribute('aria-disabled') === 'true') return;

            const matchingOption = Array.from(select.options).find(
              (optionEl) => optionEl.value === value
            );

            if (!matchingOption) return;

            /*
             * Set the real select first. The select remains the single
             * source of truth used by getSelectedOptions()/findVariant().
             * Then update the UI immediately so the selected size is visible.
             */
            select.value = matchingOption.value;

            sizeEl.dataset.open = 'false';
            trigger.setAttribute('aria-expanded', 'false');
            list.hidden = true;

            updateVariantAvailability();
            syncSizeControls();

            trigger.focus();
          };

          item.addEventListener('click', chooseSize);
          item.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault();
              chooseSize();
            }
          });

          list.appendChild(item);
        });

        trigger.addEventListener('click', () => {
          const willOpen = sizeEl.dataset.open !== 'true';
          closeAllSizeLists(sizeEl);

          sizeEl.dataset.open = willOpen ? 'true' : 'false';
          trigger.setAttribute('aria-expanded', String(willOpen));
          list.hidden = !willOpen;
        });

        sizeEl.appendChild(select);
        sizeEl.appendChild(trigger);
        sizeEl.appendChild(list);
        wrapper.appendChild(sizeEl);
        return wrapper;
      };

      // Keeps every custom size trigger/list in sync with its hidden native select.
      const syncSizeControls = () => {
        form.querySelectorAll('[data-tisso-size]').forEach((sizeEl) => {
          const select = sizeEl.querySelector('.tisso-variant__select-native');
          const trigger = sizeEl.querySelector('.tisso-size__trigger');
          const valueSpan = sizeEl.querySelector('.tisso-size__value');
          const items = sizeEl.querySelectorAll('.tisso-size__option');

          if (!select || !trigger || !valueSpan) return;

          const selectedOption = select.options[select.selectedIndex];
          const hasValue = selectedOption && selectedOption.value;
          valueSpan.textContent = hasValue
            ? selectedOption.textContent
            : select.options[0].textContent;

          const isFullyDisabled = Array.from(select.options).every((optionEl) => {
            return !optionEl.value || optionEl.disabled;
          });
          trigger.disabled = isFullyDisabled;

          items.forEach((item) => {
            const matchingOption = Array.from(select.options).find(
              (optionEl) => optionEl.value === item.dataset.value
            );

            const disabled = !matchingOption || matchingOption.disabled;
            item.setAttribute('aria-disabled', disabled ? 'true' : 'false');
            item.classList.toggle('is-selected', hasValue && matchingOption && matchingOption.value === selectedOption.value);
          });
        });
      };

      const renderVariants = (product) => {
        variantsContainer.innerHTML = '';

        if (!product.options || !product.options.length || isSimpleProduct(product)) {
          addButton.disabled = !product.available;
          addLabel.textContent = product.available ? 'ADD TO CART' : 'SOLD OUT';
          return;
        }

        const isColorOption = (option) => {
          const name = option.name.trim().toLowerCase();
          return name === 'color' || name === 'colour';
        };

        // Figma always shows Color above Size, so render in that fixed
        // order regardless of how the product's options are configured.
        const orderedOptions = product.options
          .map((option, optionIndex) => ({ option, optionIndex }))
          .sort((a, b) => {
            const aIsColor = isColorOption(a.option) ? 0 : 1;
            const bIsColor = isColorOption(b.option) ? 0 : 1;
            if (aIsColor !== bIsColor) return aIsColor - bIsColor;
            return a.optionIndex - b.optionIndex;
          });

        orderedOptions.forEach(({ option, optionIndex }) => {
          if (isColorOption(option)) {
            variantsContainer.appendChild(
              renderColorOption(option, optionIndex)
            );
          } else {
            variantsContainer.appendChild(
              renderDropdownOption(option, optionIndex)
            );
          }
        });

        // Match the Figma default: first available value is selected.
        orderedOptions.forEach(({ option, optionIndex }) => {
          const isColor = isColorOption(option);

          if (isColor) {
            const inputs = form.querySelectorAll(
              `input[name="option-${optionIndex}"]`
            );

            const firstAvailable = Array.from(inputs).find((input) => {
              const possible = getPossibleVariant(optionIndex, input.value);
              return possible && possible.available;
            });

            if (firstAvailable) firstAvailable.checked = true;
          } else {
            const select = form.querySelector(
              `select[name="option-${optionIndex}"]`
            );

            if (select) {
              const firstAvailable = Array.from(select.options).find((optionEl) => {
                if (!optionEl.value) return false;
                const possible = getPossibleVariant(optionIndex, optionEl.value);
                return possible && possible.available;
              });

              if (firstAvailable) select.value = firstAvailable.value;
            }
          }
        });

        updateVariantAvailability();
      };

      /*
       * Anchors the popup near the hotspot that triggered it, flipping
       * sides and clamping to the viewport so it never overflows. This
       * only ever writes to the dialog's own left/top — it never touches
       * anything in normal document flow, so the section can't jump.
       */
      const positionPopup = (triggerEl) => {
        if (!triggerEl || !dialog) return;

        const triggerRect = triggerEl.getBoundingClientRect();
        const dialogRect = dialog.getBoundingClientRect();
        const viewportWidth = window.innerWidth;
        const viewportHeight = window.innerHeight;

        let left = triggerRect.right + 12;
        let top = triggerRect.top - (dialogRect.height / 2) + (triggerRect.height / 2);

        // Flip to the left of the hotspot if it would overflow the right edge.
        if (left + dialogRect.width + POPUP_MARGIN > viewportWidth) {
          left = triggerRect.left - dialogRect.width - 12;
        }

        // Neither side fits (narrow viewport) — centre it instead.
        if (left < POPUP_MARGIN || left + dialogRect.width + POPUP_MARGIN > viewportWidth) {
          left = (viewportWidth - dialogRect.width) / 2;
        }

        left = Math.max(POPUP_MARGIN, Math.min(left, viewportWidth - dialogRect.width - POPUP_MARGIN));

        if (top < POPUP_MARGIN) top = POPUP_MARGIN;
        if (top + dialogRect.height + POPUP_MARGIN > viewportHeight) {
          top = viewportHeight - dialogRect.height - POPUP_MARGIN;
        }
        top = Math.max(POPUP_MARGIN, top);

        dialog.style.left = `${left}px`;
        dialog.style.top = `${top}px`;
      };

      const handleReposition = () => positionPopup(activeTrigger);

      /*
       * Locking scroll with overflow:hidden removes the scrollbar, which
       * shrinks the viewport width and shifts everything left — that is
       * the "jerk". Compensating with padding-right equal to the
       * scrollbar's width keeps the page perfectly still.
       */
      const lockScroll = () => {
        const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
        if (scrollbarWidth > 0) {
          document.body.style.paddingRight = `${scrollbarWidth}px`;
        }
        document.body.classList.add(BODY_OPEN_CLASS);
      };

      const unlockScroll = () => {
        document.body.classList.remove(BODY_OPEN_CLASS);
        document.body.style.paddingRight = '';
      };

      const openModal = (product, triggerEl) => {
        if (closeTimer) {
          clearTimeout(closeTimer);
          closeTimer = null;
        }

        activeProduct = product;
        activeTrigger = triggerEl;
        previousActiveElement = document.activeElement;

        if (triggerEl) triggerEl.setAttribute('aria-expanded', 'true');

        modalTitle.textContent = product.title;
        modalPrice.textContent = product.priceFormatted || '';
        modalDescription.textContent = product.description || '';
        setImage(product.featuredImage, product.title);

        clearError();
        renderVariants(product);

        modal.hidden = false;
        lockScroll();
        positionPopup(triggerEl);

        requestAnimationFrame(() => {
          modal.classList.add('is-open');
        });

        const firstFocusable = modal.querySelector(
          'button:not([disabled]), input:not([disabled]), select:not([disabled])'
        );

        if (firstFocusable) firstFocusable.focus();

        window.addEventListener('resize', handleReposition);
        window.addEventListener('scroll', handleReposition, true);
      };

      const closeModal = () => {
        if (modal.hidden) return;

        modal.classList.remove('is-open');
        closeAllSizeLists();

        if (activeTrigger) activeTrigger.setAttribute('aria-expanded', 'false');

        window.removeEventListener('resize', handleReposition);
        window.removeEventListener('scroll', handleReposition, true);

        const finish = () => {
          modal.hidden = true;
          unlockScroll();
          activeProduct = null;
          activeTrigger = null;
          closeTimer = null;
        };

        if (dialog) {
          dialog.addEventListener('transitionend', finish, { once: true });
          closeTimer = setTimeout(finish, 220);
        } else {
          finish();
        }

        if (previousActiveElement && typeof previousActiveElement.focus === 'function') {
          previousActiveElement.focus();
        }
      };

      const normalizeOptionValue = (value) => {
        return String(value || '')
          .trim()
          .replace(/\s+/g, ' ')
          .toLowerCase();
      };

      /*
       * The companion product is selected dynamically in the Theme Editor.
       * Its first available variant ID is resolved by Liquid above, then
       * supplied here as a plain numeric Shopify variant ID.
       */
      const getCompanionVariant = () => {
        if (!companion) return null;

        if (companion.variantId) {
          return {
            id: Number(companion.variantId),
            available: true
          };
        }

        if (Array.isArray(companion.variants)) {
          const available = companion.variants.find(
            (variant) => variant && variant.available && variant.id
          );

          return available || null;
        }

        return null;
      };

      const shouldAddCompanion = (product, variant) => {
        if (!product || !variant || !companion) return false;

        /*
         * Check the actual controls the customer selected, rather than
         * relying on variant.options alone. This makes the Black + M rule
         * work even when Shopify's option ordering differs.
         */
        const optionNames = (product.options || []).map((option) =>
          normalizeOptionValue(option.name)
        );

        const colorIndex = optionNames.findIndex(
          (name) => name === 'color' || name === 'colour'
        );
        const sizeIndex = optionNames.indexOf('size');

        if (colorIndex === -1 || sizeIndex === -1) return false;

        const selectedOptions = getSelectedOptions();

        const selectedColor = normalizeOptionValue(
          selectedOptions[colorIndex]
        );
        const selectedSize = normalizeOptionValue(
          selectedOptions[sizeIndex]
        );

        return selectedColor === 'black' && selectedSize === 'm';
      };

      const addItemsToCart = async (items) => {
        const response = await fetch(`${shopRoot}cart/add.js`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            items: items.map((item) => ({
              id: Number(item.id),
              quantity: Number(item.quantity || 1)
            }))
          })
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(
            data.description ||
            data.message ||
            'Unable to add product to cart.'
          );
        }

        return data;
      };

      root.querySelectorAll('[data-product-index]').forEach((button) => {
        button.addEventListener('click', () => {
          const product = products[Number(button.dataset.productIndex)];

          if (product) {
            openModal(product, button);
          }
        });
      });

      root.querySelectorAll('[data-tisso-close]').forEach((element) => {
        element.addEventListener('click', closeModal);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;

        if (isAnySizeListOpen()) {
          closeAllSizeLists();
          return;
        }

        if (!modal.hidden) {
          closeModal();
        }
      });

      document.addEventListener('click', (event) => {
        if (modal.hidden || !isAnySizeListOpen()) return;
        if (event.target.closest('[data-tisso-size]')) return;

        closeAllSizeLists();
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        clearError();

        const variant = findVariant();

        if (!variant) {
          showError('Please select all product options.');
          return;
        }

        if (!variant.available) {
          showError('This variant is currently unavailable.');
          return;
        }

        /*
         * Dawn behavior:
         * 1. Add the selected product variant.
         * 2. If the selected variant is Black + Medium, also add the
         *    dynamically configured Automatic companion product.
         * 3. Redirect to Shopify's normal cart page.
         *
         * There is intentionally no cart drawer refresh, cart counter
         * update, custom cart event, or Horizon real-time cart logic.
         */
        const items = [
          {
            id: variant.id,
            quantity: 1
          }
        ];

        const needsCompanion = shouldAddCompanion(activeProduct, variant);

        if (needsCompanion) {
          const companionVariant = getCompanionVariant();

          if (!companionVariant || !companionVariant.id) {
            showError(
              'The Automatic companion product is selected, but it has no available variant.'
            );
            return;
          }

          if (Number(companionVariant.id) === Number(variant.id)) {
            showError('The companion product cannot use the same variant.');
            return;
          }

          items.push({
            id: Number(companionVariant.id),
            quantity: 1
          });
        }

        addButton.disabled = true;
        addLabel.textContent = 'ADDING...';

        try {
          await addItemsToCart(items);

          // Go directly to the standard Dawn/Shopify cart page.
          window.location.assign(`${shopRoot}cart`);
        } catch (error) {
          showError(
            error.message ||
            'Unable to add the product to the cart.'
          );

          addButton.disabled = false;
          addLabel.textContent = 'ADD TO CART';
        }
      });
    })();
  </script>
</section>

