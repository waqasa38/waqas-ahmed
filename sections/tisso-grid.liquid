      font-size: 12px;
      font-weight: 300;
      line-height: 1.2;
    }

    #tisso-vision-{{ section.id }} .tisso-modal__details form {
      grid-column: 1 / -1;
      grid-row: 2;
      width: 100%;
      min-width: 0;
      padding-top: 34px;
      box-sizing: border-box;
    }

    #tisso-vision-{{ section.id }} .tisso-variant {
