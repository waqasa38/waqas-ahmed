{% comment %}
  Tisso Vision in the Wild
  - Exactly six product blocks, selectable in Theme Customizer
  - Figma-style desktop/mobile product grid
  - Figma-style compact product popup, anchored to the clicked hotspot
  - Dynamic product/variant information
  - Vanilla JavaScript only
  - AJAX Add to Cart for the selected product + optional companion product, then redirect to cart
  - Black + Medium automatically adds the configured Soft Winter Jacket
{% endcomment %}

{%- capture button_arrow_svg -%}
  <svg width="26" height="12" viewBox="0 0 26 12" fill="none" xmlns="http://www.w3.org/2000/svg" class="tisso-header__button-arrow-svg">
    <path d="M0.75 4.77298L7.37629e-08 4.77298L-7.37629e-08 6.27298L0.75 6.27298L0.75 4.77298ZM25.2803 6.05331C25.5732 5.76042 25.5732 5.28554 25.2803 4.99265L20.5074 0.21968C20.2145 -0.073213 19.7396 -0.0732131 19.4467 0.21968C19.1538 0.512574 19.1538 0.987447 19.4467 1.28034L23.6893 5.52298L19.4467 9.76562C19.1538 10.0585 19.1538 10.5334 19.4467 10.8263C19.7396 11.1192 20.2145 11.1192 20.5074 10.8263L25.2803 6.05331ZM0.75 6.27298L24.75 6.27298L24.75 4.77298L0.75 4.77298L0.75 6.27298Z" fill="currentColor"/>
  </svg>
{%- endcapture -%}

<section id="tisso-vision-{{ section.id }}" class="tisso-vision">
  <div class="tisso-vision__inner">
    {% if section.settings.heading != blank %}
      <h2 class="tisso-vision__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <div class="tisso-vision__grid">
      {% for block in section.blocks limit: 6 %}
        {% assign product = block.settings.product %}

        <article
          class="tisso-card"
          {{ block.shopify_attributes }}
          style="--hotspot-x: {{ block.settings.hotspot_x }}%; --hotspot-y: {{ block.settings.hotspot_y }}%;"
        >
          {% if product != blank %}
            <div class="tisso-card__image-wrap">
              {% if product.featured_image %}
                {{
                  product.featured_image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '360, 540, 720, 900, 1200',
                    sizes: '(min-width: 750px) 33.333vw, 50vw',
                    class: 'tisso-card__image',
                    alt: product.featured_image.alt | default: product.title | escape
                }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'tisso-card__placeholder' }}
              {% endif %}

              <button
                type="button"
                class="tisso-card__plus"
                aria-label="View {{ product.title | escape }}"
                data-product-index="{{ forloop.index0 }}"
                aria-haspopup="dialog"
                aria-expanded="false"
              >
                <span aria-hidden="true">+</span>
              </button>
            </div>
          {% else %}
            <div class="tisso-card__image-wrap tisso-card__image-wrap--empty">
              {{ 'product-1' | placeholder_svg_tag: 'tisso-card__placeholder' }}
              <span class="tisso-card__empty-text">Select a product</span>
            </div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>

  <div class="tisso-modal" data-tisso-modal hidden>
    <div class="tisso-modal__backdrop" data-tisso-close></div>

    <div
      class="tisso-modal__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="tisso-modal-title-{{ section.id }}"
    >
      <button type="button" class="tisso-modal__close" aria-label="Close" data-tisso-close>
        <span aria-hidden="true">×</span>
      </button>

      <div class="tisso-modal__content">
        <div class="tisso-modal__media">
          <img
            data-tisso-modal-image
            alt=""
            width="800"
            height="1000"
            loading="lazy"
            hidden
          >
        </div>

        <div class="tisso-modal__details">
          <h3 id="tisso-modal-title-{{ section.id }}" data-tisso-modal-title></h3>
          <div class="tisso-modal__price" data-tisso-modal-price></div>
          <div class="tisso-modal__description" data-tisso-modal-description></div>

          <form data-tisso-product-form>
            <div class="tisso-variants" data-tisso-variants></div>

            <p class="tisso-modal__error" data-tisso-error role="alert" hidden></p>

            <button type="submit" class="tisso-add" data-tisso-add>
              <span class="tisso-header__button-label" data-tisso-add-label>ADD TO CART</span>
             <span class="tisso-header__button-arrow" aria-hidden="true">{{ button_arrow_svg }}</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" data-tisso-products>
    [
      {% for block in section.blocks limit: 6 %}
        {% assign product = block.settings.product %}
        {% if product != blank %}
          {
            "id": {{ product.id | json }},
            "title": {{ product.title | json }},
            "description": {{ product.description | strip_html | json }},
            "url": {{ product.url | json }},
            "featuredImage": {% if product.featured_image %}{{ product.featured_image | image_url: width: 1200 | json }}{% else %}null{% endif %},
            "price": {{ product.price | json }},
            "priceFormatted": {{ product.price | money | json }},
            "available": {{ product.available | json }},
            "options": {{ product.options_with_values | json }},
            "variants": [
              {% for variant in product.variants %}
                {
                  "id": {{ variant.id | json }},
                  "title": {{ variant.title | json }},
                  "available": {{ variant.available | json }},
                  "price": {{ variant.price | json }},
                  "priceFormatted": {{ variant.price | money | json }},
                  "options": {{ variant.options | json }},
                  "featuredImage": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 1200 | json }}{% else %}null{% endif %}
                }{% unless forloop.last %},{% endunless %}
              {% endfor %}
            ]
          }{% unless forloop.last %},{% endunless %}
        {% endif %}
      {% endfor %}
    ]
  </script>

  <script type="application/json" data-tisso-companion>
    {% if section.settings.companion_product != blank %}
      {
        "id": {{ section.settings.companion_product.id | json }},
        "title": {{ section.settings.companion_product.title | json }},
        "variantId": {% if section.settings.companion_product.selected_or_first_available_variant != blank %}{{ section.settings.companion_product.selected_or_first_available_variant.id | json }}{% else %}null{% endif %},
        "variants": [
          {% for variant in section.settings.companion_product.variants %}
            {
              "id": {{ variant.id | json }},
              "available": {{ variant.available | json }}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      }
    {% else %}
      null
    {% endif %}
  </script>

  <style>
    #tisso-vision-{{ section.id }} {
      --tisso-bg: {{ section.settings.background }};
      --tisso-gap: {{ section.settings.grid_gap }}px;
      background: var(--tisso-bg);
      padding: {{ section.settings.section_padding }}px 0;
    }

    #tisso-vision-{{ section.id }} .tisso-vision__inner {
      width: min(calc(100% - 48px), {{ section.settings.max_width }}px);
      margin: 0 auto;
    }

    #tisso-vision-{{ section.id }} .tisso-vision__heading {
      margin: 0 0 34px;
      color: #111;
      font-family: Lustria, Georgia, "Times New Roman", serif;
      font-size: 36px;
      font-weight: 400;
      font-style: normal;
      line-height: 1.05;
      letter-spacing: 0px;
    }

    #tisso-vision-{{ section.id }} .tisso-vision__grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--tisso-gap);
    }

    #tisso-vision-{{ section.id }} .tisso-card {
      min-width: 0;
    }

    #tisso-vision-{{ section.id }} .tisso-card__image-wrap {
      position: relative;
      overflow: hidden;
      aspect-ratio: 1 / 1;
      background: #e8e8e8;
    }

    #tisso-vision-{{ section.id }} .tisso-card__image,
    #tisso-vision-{{ section.id }} .tisso-card__placeholder {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Each block can have its own Figma hotspot coordinates. */
    #tisso-vision-{{ section.id }} .tisso-card__plus {
      position: absolute;
      left: var(--hotspot-x);
      top: var(--hotspot-y);
      width: 30px;
      height: 30px;
      transform: translate(-50%, -50%);
      display: grid;
      place-items: center;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: #fff;
      color: #111;
      box-shadow: 0 1px 4px rgba(0, 0, 0, .18);
      cursor: pointer;
      font-family: Arial, sans-serif;
      font-size: 20px;
      font-weight: 300;
      line-height: 30px;
      z-index: 2;
      transition: transform .15s ease, box-shadow .15s ease;
    }

    #tisso-vision-{{ section.id }} .tisso-card__plus:hover,
    #tisso-vision-{{ section.id }} .tisso-card__plus[aria-expanded="true"] {
      transform: translate(-50%, -50%) scale(1.08);
      box-shadow: 0 3px 10px rgba(0, 0, 0, .22);
    }

    #tisso-vision-{{ section.id }} .tisso-card__image-wrap--empty {
      display: grid;
      place-items: center;
      position: relative;
    }

    #tisso-vision-{{ section.id }} .tisso-card__empty-text {
      position: absolute;
      color: #555;
      font-size: 13px;
    }

    /*
     * Popup
     * The wrapper is fixed + inset:0 purely as a positioning context; it is
     * pointer-events:none by default so it never blocks or reflows the page.
     * The backdrop and dialog opt back into pointer events only while open.
     * Opening/closing only ever animates opacity + transform, so the
     * surrounding section never moves or reflows.
     */
    #tisso-vision-{{ section.id }} .tisso-modal[hidden] {
      display: none;
    }

    #tisso-vision-{{ section.id }} .tisso-modal {
      position: fixed;
      inset: 0;
      z-index: 99999;
      pointer-events: none;
    }

    #tisso-vision-{{ section.id }} .tisso-modal__backdrop {
      position: absolute;
      inset: 0;
      background: rgba(17, 17, 17, .18);
      opacity: 0;
      pointer-events: none;
      transition: opacity .18s ease;
    }

    #tisso-vision-{{ section.id }} .tisso-modal.is-open .tisso-modal__backdrop {
      opacity: 1;
      pointer-events: auto;
    }

    #tisso-vision-{{ section.id }} .tisso-modal__dialog {
      position: fixed;
      top: 0;
      left: 0;
      z-index: 1;
      width: min(92vw, 390px);
      overflow: visible;
      background: #fff;
      box-shadow: 0 18px 60px rgba(0, 0, 0, .22);
      opacity: 0;
      transform: translateY(6px) scale(.98);
      transform-origin: top left;
      pointer-events: none;
      transition: opacity .18s ease, transform .18s ease;
      will-change: transform, opacity;
    }

    #tisso-vision-{{ section.id }} .tisso-modal.is-open .tisso-modal__dialog {
      opacity: 1;
      transform: translateY(0) scale(1);
      pointer-events: auto;
    }

    #tisso-vision-{{ section.id }} .tisso-modal__close {
      position: absolute;
      top: 10px;
      right: 10px;
      z-index: 4;
      width: 28px;
      height: 28px;
      padding: 0;
      border: 0;
      background: #fff;
      color: #111;
      cursor: pointer;
      font-family: Arial, sans-serif;
      font-size: 25px;
      font-weight: 300;
      line-height: 28px;
    }

    #tisso-vision-{{ section.id }} .tisso-modal__content {
      display: grid;
      grid-template-columns: 145px minmax(0, 1fr);
      min-height: 245px;
    }

    #tisso-vision-{{ section.id }} .tisso-modal__media {
      min-width: 0;
      background: #eee;
    }

    #tisso-vision-{{ section.id }} .tisso-modal__media img {
      display: block;
      width: 100%;
      height: 100%;
      min-height: 245px;
      object-fit: cover;
    }

    #tisso-vision-{{ section.id }} .tisso-modal__details {
      min-width: 0;
      padding: 22px 20px 20px;
    }

    #tisso-vision-{{ section.id }} .tisso-modal__details h3 {
      margin: 0 28px 10px 0;
      color: #000000;
      font-family: Jost, -apple-system, BlinkMacSystemFont, Helvetica Neue, Arial, sans-serif;
      font-size: 16px;
      font-weight: 300;
      line-height: 1.2;
    }

    #tisso-vision-{{ section.id }} .tisso-modal__price {
      margin-bottom: 12px;
      color: #000000;
      font-size: 16px;
      line-height: 1.2;
    }

    #tisso-vision-{{ section.id }} .tisso-modal__description {
      margin-bottom: 16px;
      color: #000000;
      font-size: 11px;
      line-height: 1.35;
    }

    /* Figma: Color = segmented buttons with a colour swatch, Size = dropdown. */
    #tisso-vision-{{ section.id }} .tisso-variant {
      margin-bottom: 12px;
    }

    #tisso-vision-{{ section.id }} .tisso-variant__label {
      display: block;
      margin-bottom: 6px;
      color: #000000;
      font-size: 11px;
      line-height: 1.2;
    }

    #tisso-vision-{{ section.id }} .tisso-variant__values {
      display: flex;
      flex-wrap: wrap;
      border: 1px solid #000;
    }

    #tisso-vision-{{ section.id }} .tisso-variant__value {
      position: relative;
      min-width: 0;
      flex: 1 1 50%;
    }

    #tisso-vision-{{ section.id }} .tisso-variant__value + .tisso-variant__value {
      border-left: 1px solid #000;
    }

    #tisso-vision-{{ section.id }} .tisso-variant__input {
      position: absolute;
      width: 1px;
      height: 1px;
      opacity: 0;
      pointer-events: none;
    }

    #tisso-vision-{{ section.id }} .tisso-variant__button {
      display: flex;
      align-items: stretch;
      overflow: hidden;
      color: #000;
      background: #fff;
      cursor: pointer;
      font-size: 13px;
      line-height: 1;
      text-align: left;
    }

    #tisso-vision-{{ section.id }} .tisso-variant__button-text {
      display: flex;
      align-items: center;
      overflow: hidden;
      padding: 10px 12px;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    /* Flush, full-height colour bar at the leading edge of each segment. */
    #tisso-vision-{{ section.id }} .tisso-variant__swatch {
      width: 5px;
      flex: 0 0 5px;
      align-self: stretch;
    }

    #tisso-vision-{{ section.id }} .tisso-variant__input:checked + .tisso-variant__button {
      color: #fff;
      background: #000;
    }

    #tisso-vision-{{ section.id }} .tisso-variant__input:disabled + .tisso-variant__button {
      color: #aaa;
      cursor: not-allowed;
      text-decoration: line-through;
    }

    /*
     * Custom Size control (Components 212/213). A native <select> is kept
     * in the DOM (visually hidden) purely as the source of truth for
     * value/availability logic already wired up in updateVariantAvailability;
     * this custom trigger + listbox is what the user actually sees and
     * clicks, so it can match the Figma states exactly.
     */
    #tisso-vision-{{ section.id }} .tisso-variant__select-native {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    #tisso-vision-{{ section.id }} .tisso-size {
      position: relative;
    }

    #tisso-vision-{{ section.id }} .tisso-size__trigger {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      width: 100%;
      min-height: 44px;
      padding: 0 14px;
      border: 1px solid #111;
      border-radius: 0;
      outline: 0;
      background: #fff;
      color: #111;
      font-family: inherit;
      font-size: 13px;
      line-height: 1.2;
      text-align: left;
      cursor: pointer;
    }

    #tisso-vision-{{ section.id }} .tisso-size__trigger:disabled {
      color: #aaa;
      border-color: #ccc;
      cursor: not-allowed;
    }

    #tisso-vision-{{ section.id }} .tisso-size__value {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    #tisso-vision-{{ section.id }} .tisso-size__chevron {
      flex: 0 0 auto;
      width: 8px;
      height: 8px;
      border-right: 1.5px solid #000;
      border-bottom: 1.5px solid #000;
      transform: rotate(45deg);
      transition: transform .15s ease;
    }

    #tisso-vision-{{ section.id }} .tisso-size[data-open="true"] .tisso-size__chevron {
      transform: rotate(-135deg);
    }

    #tisso-vision-{{ section.id }} .tisso-size__list {
      position: absolute;
      z-index: 5;
      top: calc(100% - 1px);
      left: 0;
      right: 0;
      margin: 0;
      padding: 0;
      list-style: none;
      border: 1px solid #000;
      border-top: 0;
      background: #fff;
      max-height: 190px;
      overflow-y: auto;
      box-shadow: 0 12px 24px rgba(0, 0, 0, .12);
    }

    #tisso-vision-{{ section.id }} .tisso-size__list[hidden] {
      display: none;
    }

    /*
     * Keep the Size dropdown fully scrollable, but hide the browser's
     * native scrollbar so it matches the Figma design.
     */
    #tisso-vision-{{ section.id }} .tisso-size__list {
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    #tisso-vision-{{ section.id }} .tisso-size__list::-webkit-scrollbar {
      width: 0;
      height: 0;
      display: none;
    }

    #tisso-vision-{{ section.id }} .tisso-size__option {
      padding: 12px 14px;
      color: #000;
      font-size: 13px;
      line-height: 1.2;
      cursor: pointer;
    }

    #tisso-vision-{{ section.id }} .tisso-size__option:hover,
    #tisso-vision-{{ section.id }} .tisso-size__option.is-selected {
      background: #000;
      color: #fff;
    }

    #tisso-vision-{{ section.id }} .tisso-size__option[aria-disabled="true"] {
      color: #ccc;
      cursor: not-allowed;
      text-decoration: line-through;
    }

    #tisso-vision-{{ section.id }} .tisso-size__option[aria-disabled="true"]:hover {
      background: #fff;
      color: #ccc;
    }

    #tisso-vision-{{ section.id }} .tisso-add {
      width: 100%;
      min-height: 38px;
      margin-top: 10px;
      padding: 8px 10px;
      border: 0;
      background: #000;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 30px;
      cursor: pointer;
      font-size: 10px;
      font-weight: 400;
      line-height: 1;
    }

    #tisso-vision-{{ section.id }} .tisso-add:disabled {
      opacity: .55;
      cursor: not-allowed;
    }

    #tisso-vision-{{ section.id }} .tisso-add__arrow {
      font-size: 18px;
      line-height: 1;
    }

    #tisso-vision-{{ section.id }} .tisso-modal__error {
      margin: 7px 0 0;
      color: #b42318;
      font-size: 10px;
      line-height: 1.3;
    }

    /*
     * Locking scroll toggles overflow only; the JS compensates the
     * disappearing scrollbar with padding-right so nothing shifts
     * horizontally when the popup opens or closes.
     */
    body.tisso-modal-open-{{ section.id }} {
      overflow: hidden;
    }

    @media (max-width: 749px) {
      #tisso-vision-{{ section.id }} {
        padding-top: {{ section.settings.mobile_section_padding }}px;
        padding-bottom: {{ section.settings.mobile_section_padding }}px;
      }

      #tisso-vision-{{ section.id }} .tisso-vision__inner {
        width: calc(100% - 24px);
      }

      #tisso-vision-{{ section.id }} .tisso-vision__heading {
        margin-bottom: 18px;
        font-size: 24px;
        text-align: center;
        padding-bottom: 10px;
      }

      #tisso-vision-{{ section.id }} .tisso-vision__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 2px;
      }

      #tisso-vision-{{ section.id }} .tisso-card__plus {
        width: 24px;
        height: 24px;
        font-size: 16px;
        line-height: 24px;
      }

      #tisso-vision-{{ section.id }} .tisso-modal__dialog {
        width: min(94vw, 365px);
      }

      #tisso-vision-{{ section.id }} .tisso-modal__content {
        grid-template-columns: 112px minmax(0, 1fr);
        min-height: 225px;
      }

      #tisso-vision-{{ section.id }} .tisso-modal__media img {
        min-height: 225px;
      }

      #tisso-vision-{{ section.id }} .tisso-modal__details {
        padding: 18px 14px 14px;
      }

      #tisso-vision-{{ section.id }} .tisso-modal__details h3 {
        font-size: 14px;
      }

      #tisso-vision-{{ section.id }} .tisso-modal__price {
        font-size: 14px;
      }

      #tisso-vision-{{ section.id }} .tisso-modal__description {
        font-size: 9px;
      }
    }

    /*
     * Figma popup styling — intentionally NOT mobile-only.
     * The same popup proportions, controls, borders and spacing are used
     * on desktop and mobile. The popup itself never changes size/position
     * when the Size dropdown is opened.
     */
    #tisso-vision-{{ section.id }} .tisso-modal__dialog {
      width: 365px;
      max-width: calc(100vw - 24px);
      overflow: hidden;
      background: #fff;
      box-sizing: border-box;
    }

    #tisso-vision-{{ section.id }} .tisso-modal__close {
      top: 10px;
      right: 14px;
      width: 28px;
      height: 28px;
      font-size: 25px;
      line-height: 28px;
    }

    #tisso-vision-{{ section.id }} .tisso-modal__content {
      display: grid;
      grid-template-columns: 138px minmax(0, 1fr);
      column-gap: 9px;
      min-height: 0;
      padding: 38px 16px 23px;
      box-sizing: border-box;
    }

    #tisso-vision-{{ section.id }} .tisso-modal__media {
      width: 138px;
      height: 164px;
      min-width: 0;
      grid-column: 1;
      grid-row: 1;
    }

    #tisso-vision-{{ section.id }} .tisso-modal__media img {
      width: 138px;
      height: 164px;
      min-height: 0;
      object-fit: cover;
    }

    #tisso-vision-{{ section.id }} .tisso-modal__details {
      display: contents;
    }

    #tisso-vision-{{ section.id }} .tisso-modal__details h3 {
      grid-column: 2;
      grid-row: 1;
      align-self: start;
      margin: 17px 12px 0 0;
      color: #111;
      font-family: Jost;
      font-size: 16px;
      font-weight: 300;
      line-height: 1.18;
    }

    #tisso-vision-{{ section.id }} .tisso-modal__price {
      grid-column: 2;
      grid-row: 1;
      align-self: start;
      margin: 57px 0 0;
      color: #111;
      font-family: Lustria, Georgia, "Times New Roman", serif;
      font-size: 16px;
      line-height: 1.15;
    }

    #tisso-vision-{{ section.id }} .tisso-modal__description {
      grid-column: 2;
